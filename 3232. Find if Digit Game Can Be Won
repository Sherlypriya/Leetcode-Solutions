class Solution {
    public boolean canAliceWin(int[] nums) {
        int sing=0;
        int doub=0;
        for(int i=0;i<nums.length;i++){
            if(nums[i]<10){
                sing+=nums[i];
            }
            else{
                doub+=nums[i];
            }
        }
        return sing != doub;
    }
}
