class Solution {
    public int integerReplacement(int n) {
        int count = 0;
        long k = n;
        while (k > 1) {
            if (k % 2 == 0) {
                k = k / 2;
                count++;
            } 
            else {
                if (k == 3 || k % 4 == 1) {
                    k = k - 1;
                } 
                else {
                    k = k + 1;
                }
                count++;
            }
        }

        return count;
    }
}
