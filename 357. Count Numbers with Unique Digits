class Solution {
    public int countNumbersWithUniqueDigits(int n) {

        if (n == 0) {
            return 1;
        }

        int count = 10; // 0 to 9

        int uniqueDigits = 9;
        int availableDigits = 9;

        while (n > 1 && availableDigits > 0) {
            uniqueDigits = uniqueDigits * availableDigits;
            count += uniqueDigits;

            availableDigits--;
            n--;
        }

        return count;
    }
}
