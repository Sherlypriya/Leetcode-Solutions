class Solution {
    public boolean checkDivisibility(int n) {
        int sum=0;
        int pro=1;
        int num=n;
        while(n>0){
            sum+=n%10;
            pro*=n%10;
            n/=10;
        }
        int tot=sum+pro;
        if(num%tot==0){
            return true;
        }
        return false;

    }
}
