class Solution {
    public int maxProduct(int[] nums) {
        int maxone=0;
        int maxtwo=0;
        for(int i=0;i<nums.length;i++){
            if(nums[i]>maxone){
                maxtwo=maxone;
                maxone=nums[i];
            }
            else if(maxtwo<nums[i]){
                maxtwo=nums[i];
            }
        }

        return (maxone-1)*(maxtwo-1);
    }
}
